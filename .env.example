SECRET_KEY=замените-на-случайную-строку
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,splithome.ru,www.splithome.ru

DB_NAME=splithome
DB_USER=splithome
DB_PASSWORD=сильный-пароль
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

BREEZ_AUTH_HEADER=Basic REPLACE_WITH_BASE64_OF_LOGIN_COLON_PASSWORD
BREEZ_BASE_URL=https://api.breez.ru/v1/

# Rusklimat REST API (internet-partner.rusklimat.com)
# JWT обновляется вручную раз в сутки (см. memory/rusklimat_rest.md).
# CONTRACTOR_GUID — fallback, основной берётся из JWT-payload.
RUSKLIMAT_JWT_TOKEN=
RUSKLIMAT_CONTRACTOR_GUID=e51a9046-47ff-4d7e-977d-7dba40c0a979

# Daichi Business partner API (api.daichi.ru/b2b/v1/)
DAICHI_ACCESS_TOKEN=
DAICHI_BASE_URL=https://api.daichi.ru/b2b/v1/
DAICHI_STORE_ID=default

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@splithome.ru
MANAGER_EMAIL=zakaz@splithome.ru

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# По умолчанию https://api.telegram.org. На VPS с IPv4-блокировкой Telegram
# поднимаем socat tg_proxy на host-gateway и пишем TELEGRAM_API_URL=https://api.telegram.org:8443
TELEGRAM_API_URL=https://api.telegram.org

# SEO / аналитика
# Счётчик splithome.ru — 112352888. Пусто = блок Метрики не рендерится вообще,
# то есть сайт работает без аналитики. На проде значение задаётся в .env.
YANDEX_METRIKA_ID=112352888
# Токены подтверждения прав в панелях вебмастеров (см. docs/seo-webmaster-setup.md).
# Вставляются мета-тегом в <head>. Пусто = тег не выводится.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
